# ==========================================================
# Nginx config — SERVIDOR DE PRODUCCIÓN
# Usa variables de entorno: NGINX_API_SERVER_NAME, NGINX_FRONT_SERVER_NAME,
#                           SSL_CERT_PATH, SSL_KEY_PATH
# ==========================================================

upstream php-upstream {
    least_conn;
    server php:9000;
}

# ----------------------------------------------------------
# 1. HTTP → HTTPS redirect (también sirve el challenge de Certbot)
# ----------------------------------------------------------
server {
    listen 80;
    server_name ${NGINX_API_SERVER_NAME} ${NGINX_FRONT_SERVER_NAME};

    # Ruta usada por Certbot para validar el dominio (webroot)
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    # Todo lo demás → redirigir a HTTPS
    location / {
        return 301 https://$host$request_uri;
    }
}

# ----------------------------------------------------------
# 2. HTTPS — API / Backend (Laravel)
# ----------------------------------------------------------
server {
    listen 443 ssl;
    server_name ${NGINX_API_SERVER_NAME};

    ssl_certificate     ${SSL_CERT_PATH};
    ssl_certificate_key ${SSL_KEY_PATH};
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_ciphers         HIGH:!aNULL:!MD5;

    root /var/www/html/public;
    index index.php;

    error_log  /var/log/nginx/api_error.log;
    access_log /var/log/nginx/api_access.log;
    error_page 404 /index.php;

    client_max_body_size 100M;

    # Laravel Reverb (WebSockets)
    location /app/ {
        proxy_pass http://supervisor_reverb:8080;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Port $server_port;
        proxy_cache_bypass $http_upgrade;
        proxy_read_timeout 86400;
        proxy_send_timeout 86400;
        proxy_connect_timeout 86400;
    }

    location /apps/ {
        proxy_pass http://supervisor_reverb:8080;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Port $server_port;
        proxy_cache_bypass $http_upgrade;
        proxy_read_timeout 86400;
        proxy_send_timeout 86400;
        proxy_connect_timeout 86400;
    }

    location ~ \.php$ {
        try_files $uri =404;
        fastcgi_pass php-upstream;
        fastcgi_index index.php;
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
        fastcgi_param REQUEST_METHOD $request_method;
    }

    location / {
        try_files $uri $uri/ /index.php?$query_string;
        gzip_static on;
    }
}

# ----------------------------------------------------------
# 3. HTTPS — Frontend (Vue build estático)
# ----------------------------------------------------------
server {
    listen 443 ssl;
    server_name ${NGINX_FRONT_SERVER_NAME};

    ssl_certificate     ${SSL_CERT_PATH};
    ssl_certificate_key ${SSL_KEY_PATH};
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_ciphers         HIGH:!aNULL:!MD5;

    root /var/www/front/dist;
    index index.html;

    error_log  /var/log/nginx/front_error.log;
    access_log /var/log/nginx/front_access.log;

    # Vue Router (history mode) — cualquier ruta devuelve index.html
    location / {
        try_files $uri $uri/ /index.html;
        gzip_static on;
    }

    # Cache largo para assets compilados (tienen hash en el nombre)
    location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot)$ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }
}
