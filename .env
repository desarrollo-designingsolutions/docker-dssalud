# ============================================
# .env.server  — Producción (servidor real)
# ============================================

# repositorio backend
REPOSITORY_BACKEND=docker
# repositorio frontend
REPOSITORY_FRONTEND=docker

# Docker Compose
COMPOSE_PROJECT_NAME=dssalud

# Nginx Ports — en producción van al puerto estándar
HTTP_PORT=80
HTTPS_PORT=443

# Other Services Ports (internos, no expuestos al público)
MYSQL_PORT=3308
REDIS_PORT_1=6379
REDIS_PORT_2=6380
# VUE_PORT ya no se usa — el front se sirve estático por Nginx

# Nginx Configuration
NGINX_API_SERVER_NAME=api.radicacion.desarrollo.com.co
NGINX_FRONT_SERVER_NAME=radicacion.desarrollo.com.co

# Certificados Let's Encrypt (los genera init-certbot.sh)
SSL_CERT_PATH=/etc/letsencrypt/live/radicacion.desarrollo.com.co/fullchain.pem
SSL_KEY_PATH=/etc/letsencrypt/live/radicacion.desarrollo.com.co/privkey.pem

# MySQL Configuration
MYSQL_ROOT_PASSWORD=12349876
MYSQL_DATABASE=bd_ds_salud
MYSQL_USER=root
MYSQL_PASSWORD=12349876

# Redis Configuration
REDIS_PASSWORD=

# Laravel Backend Environment
APP_ENV=production
APP_DEBUG=false
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=bd_ds_salud
DB_USERNAME=root
DB_PASSWORD=DB_PASSWORD

# Laravel Reverb
REVERB_APP_ID=948232
REVERB_APP_KEY=otm5syqaviw1uw9iqpen
REVERB_APP_SECRET=hy0o6kimnwuccchdf55u
REVERB_HOST=supervisor_reverb
REVERB_PORT=8080
REVERB_SCHEME=http

# Vue Frontend (variables usadas en tiempo de BUILD)
VITE_REVERB_APP_KEY=otm5syqaviw1uw9iqpen
VITE_REVERB_HOST=api.radicacion.desarrollo.com.co
VITE_REVERB_PORT=443
VITE_REVERB_SCHEME=https
VITE_API_BASE_URL=https://api.radicacion.desarrollo.com.co

DOCKER_UID=1000
DOCKER_GID=1000